# Domain Configuration
DOMAIN=ciwg-roots-sage.local

# Database Configuration
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_HOST=mysql

# WordPress Configuration
WP_ENV=development
WP_HOME=http://ciwg-roots-sage.local
WP_SITEURL=http://ciwg-roots-sage.local/wp

# WordPress Salts (generate at https://roots.io/salts.html)
# Replace these with your own unique values
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# =============================================================================
# Production Configuration (uncomment for production)
# =============================================================================

# ACME_EMAIL=admin@example.com

# WordPress DB (for external services)
# WORDPRESS_DB_HOST=mysql
# WORDPRESS_DB_USER=airflow
# WORDPRESS_DB_PASSWORD=changeme
# WORDPRESS_DB_NAME=wp_airflow

# Redis Cache
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB_INDEX=0

# Resource Limits
# MEMORY_LIMIT=1G
# WP_CACHE=true
# WP_DEBUG=false
# WP_DEBUG_LOG=true

